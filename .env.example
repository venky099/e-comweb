# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# ---- Django core ----
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ---- Database (PostgreSQL) ----
# In development you can leave this exactly as it is. If no PostgreSQL server
# answers at the address below, the project automatically uses a local SQLite
# file and prints a line saying so -- a fresh clone runs with no setup.
# Production (config/settings/prod.py) never falls back; it requires this.
DATABASE_URL=postgres://user:password@host:5432/dbname
CONN_MAX_AGE=60
DB_SSLMODE=require

# Force SQLite and skip the check entirely.
USE_SQLITE=False

# Set to False to require PostgreSQL in development too, so a missing server
# is an error rather than a silent fallback.
DB_FALLBACK=True

# ---- Cache (optional; falls back to in-memory when blank) ----
REDIS_URL=

# ---- REST API / JWT ----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ---- Payments (Razorpay | Stripe | mock) ----
PAYMENT_GATEWAY=mock
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# ---- Storefront branding & business rules ----
SITE_NAME=Lumen Store
SITE_TAGLINE=Everything you need, delivered.
SUPPORT_EMAIL=support@lumenstore.test
SUPPORT_PHONE=+91 90000 00000
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=Rs.
DELIVERY_CHARGE=49.00
FREE_DELIVERY_THRESHOLD=999.00
TAX_RATE_PERCENT=0.00
MAX_CART_QUANTITY_PER_ITEM=10
ORDER_CANCEL_WINDOW_HOURS=24
RETURN_WINDOW_DAYS=7
LOW_STOCK_THRESHOLD=5

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@lumenstore.test
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---- Production hardening ----
ADMIN_URL=staff-console/
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- AWS (static/media via django-storages) ----
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
